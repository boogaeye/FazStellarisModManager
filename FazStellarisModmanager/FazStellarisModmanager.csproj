<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FazStellarisModmanager</RootNamespace>
    <Version>0.1.1</Version>
    <!-- Program.Main also runs the Workshop helper (see WorkshopHelperProtocol.Argument) without starting WPF. -->
    <StartupObject>FazStellarisModmanager.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FazStellarisModmanager.Core\FazStellarisModmanager.Core.csproj" />
    <ProjectReference Include="..\FazStellarisModmanager.Steam\FazStellarisModmanager.Steam.csproj" />
  </ItemGroup>

</Project>
