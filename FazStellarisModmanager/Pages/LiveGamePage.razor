@page "/live"
@implements IAsyncDisposable
@inject LiveFeed Feed
@using FazStellarisModmanager.Core.Diplomacy
@inject IJSRuntime JS

<div class="live-page">
    <div class="live-bar @(Feed.Source == LiveSource.HostDisconnected ? "warn" : Feed.Current is null ? "" : "ok")">
        <span class="dot"></span>
        @if (Feed.Current is { } s)
        {
            @if (Feed.Source == LiveSource.Host)
            {
                <b>Live from @(Feed.HostName ?? "the host")</b>
                <span class="muted">· game date @s.Date · received @Ago(Feed.ReceivedUtc!.Value)</span>
            }
            else if (Feed.Source == LiveSource.HostDisconnected)
            {
                <b>Host disconnected</b>
                <span class="muted">· showing @s.Date from @Ago(Feed.ReceivedUtc!.Value)</span>
                <button class="small" @onclick="() => Feed.UseLocal()">Use my own saves</button>
            }
            else
            {
                <b>@s.SaveName</b>
                <span class="muted">· game date @s.Date · saved @Ago(s.SavedUtc) · @Path.GetFileName(s.SavePath)</span>
            }
        }
        else
        {
            <b>@(Feed.Status ?? "Looking for saves…")</b>
        }
        @if (Feed.Reading)
        {
            <span class="muted">· reading a newer save…</span>
        }
        <span class="spacer"></span>
        @if (Feed.Source != LiveSource.HostDisconnected && Feed.Current is { Players.Count: > 1 } multi)
        {
            <label class="inline">Viewing as
                <select value="@(viewer?.ToString() ?? "")" @onchange="PickViewer">
                    <option value="">Choose…</option>
                    @foreach (var p in multi.Players)
                    {
                        <option value="@p.CountryId">@p.Name</option>
                    }
                </select>
            </label>
        }
    </div>
    @if (Feed.Error is not null)
    {
        <p class="status error">@Feed.Error</p>
    }

    @if (Feed.Current is { } snap && viewer is null && snap.Players.Count > 1)
    {
        <p class="status">Choose who you are in this game ("Viewing as") to see the scoreboard from your empire's point of view.</p>
    }
    else if (Feed.Current is { } snap2 && me is not null)
    {
        <div class="live-grid">
            <aside class="live-side">
                <div class="head">
                    <span class="lflag big" style="background:@FlagColor(me.Flag)">@Initial(CountryNames.Display(me))</span>
                    <div>
                        <h3>@CountryNames.Display(me)</h3>
                        <div class="muted">You@(PlayerOf(snap2, me.Id) is { } pn ? " · " + pn : "")</div>
                    </div>
                    <span class="spacer"></span>
                    <span class="lrank">#@me.VictoryRank</span>
                </div>
                <div class="lstat"><span>Victory score</span><span><LiveStat Value="new StatValue(me.VictoryScore)" /> <span class="lr">#@me.VictoryRank</span></span></div>
                <div class="lstat">
                    <span>Diplomatic weight</span>
                    @if (dw is null)
                    {
                        <span>—</span>
                    }
                    else
                    {
                        <span>@(dw.Approximate ? "≈ " : "")@dw.Real.ToString("N0")</span>
                    }
                </div>
                @if (dw is not null)
                {
                    @if (dw.Real < 0)
                    {
                        <div class="lstat"><span></span><span class="ovf">In game: 0 (negative weight is shown as 0)</span></div>
                    }
                    <details class="ldiplo">
                        <summary>Breakdown</summary>
                        <div class="lstat"><span>Total: @dw.Real.ToString("N0")</span></div>
                        <div class="lines">
                            @foreach (var b in dw.Overall)
                            {
                                <div class="@BonusClass(b)">@b.Name @Pct(b)</div>
                            }
                        </div>
                        <div class="lstat"><span>Base: @dw.BaseTotal.ToString("N0")</span></div>
                        @foreach (var (label, from, part) in Parts(dw))
                        {
                            <div class="lstat"><span>@label: @part.Total.ToString("N0")</span></div>
                            <div class="lines">
                                <div>From @from: @part.Base.ToString("N0") <span class="muted">(@part.Input.ToString("N0") × @part.Factor.ToString("0.###"))</span></div>
                                @foreach (var b in part.Bonuses)
                                {
                                    <div class="@BonusClass(b)">@b.Name @Pct(b)</div>
                                }
                            </div>
                        }
                        <p class="muted">@DiploBreakdown.NotCalculated Some conditional mod resolutions are not counted either.</p>
                    </details>
                }
                <div class="lstat"><span>Military power</span><span><LiveStat Value="new StatValue(me.MilitaryPower)" />@MyRank(BoardStat.Military)</span></div>
                <div class="lstat"><span>Economy power</span><span><LiveStat Value="new StatValue(me.EconomyPower)" />@MyRank(BoardStat.Economy)</span></div>
                <div class="lstat"><span>Tech power</span><span><LiveStat Value="new StatValue(me.TechPower)" />@MyRank(BoardStat.Tech)</span></div>
                <div class="lstat"><span>Fleet size</span><span><LiveStat Value="new StatValue(me.FleetSize)" />@MyRank(BoardStat.Fleet)</span></div>
                <div class="lstat"><span>Empire size</span><span><LiveStat Value="new StatValue(me.EmpireSize)" />@MyRank(BoardStat.EmpireSize)</span></div>
                <div class="lstat"><span>Pops</span><span><LiveStat Value="new StatValue(me.Pops)" />@MyRank(BoardStat.Pops)</span></div>
                <p class="muted">Known empires: @rows.Count(r => r.Known && !r.IsViewer) of @(rows.Count - 1)</p>
            </aside>
            <div class="live-board" @ref="boardEl">
                <div class="lhdr"><span>#</span><span></span><span>Empire</span>@foreach (var (stat, label) in Columns)
                    {
                        <button class="lsort @(sort == stat ? "active" : "")" title="@SortTip(stat)" @onclick="() => SetSort(stat)">@label@(sort == stat ? (worstFirst ? " ▲" : " ▼") : "")</button>
                    }</div>
                @foreach (var r in sorted)
                {
                    <div @key="r.Id" class="lrow @(r.IsViewer ? "me" : "") @(r.Known ? "" : "unknown")" data-id="@r.Id" data-rank="@r.Rank">
                        <span class="pos">@r.Rank</span>
                        <span class="lflag" style="background:@(r.Known ? FlagColor(r.Flag) : "var(--border)")">@(r.Known ? Initial(r.Name) : "?")</span>
                        <span class="who">@r.Name
                            @if (r.IsViewer) { <span class="pl">YOU</span> }
                            else if (r.PlayerName is { } player) { <span class="pl">@player</span> }
                        </span>
                        <span class="num"><LiveStat Value="r.Score" />@RankOf(r, BoardStat.Score)</span>
                        <span class="num"><LiveStat Value="r.Military" />@RankOf(r, BoardStat.Military)</span>
                        <span class="num"><LiveStat Value="r.Economy" />@RankOf(r, BoardStat.Economy)</span>
                        <span class="num"><LiveStat Value="r.Tech" />@RankOf(r, BoardStat.Tech)</span>
                        <span class="num"><LiveStat Value="r.Fleet" />@RankOf(r, BoardStat.Fleet)</span>
                        <span class="num"><LiveStat Value="r.EmpireSize" />@RankOf(r, BoardStat.EmpireSize)</span>
                        <span class="num"><LiveStat Value="r.Pops" />@RankOf(r, BoardStat.Pops)</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    ElementReference boardEl;
    IJSObjectReference? module;
    int? viewer;
    SaveCountry? me;
    DiploBreakdown? dw;
    IReadOnlyList<BoardRow> rows = [];
    IReadOnlyList<BoardRow> sorted = [];
    IReadOnlyDictionary<int, IReadOnlyDictionary<BoardStat, int>> ranks = new Dictionary<int, IReadOnlyDictionary<BoardStat, int>>();
    BoardStat sort = BoardStat.Score;
    bool worstFirst;

    static readonly (BoardStat Stat, string Label)[] Columns =
    [
        (BoardStat.Score, "Score"), (BoardStat.Military, "Military"), (BoardStat.Economy, "Economy"), (BoardStat.Tech, "Tech"),
        (BoardStat.Fleet, "Fleet"), (BoardStat.EmpireSize, "Empire size"), (BoardStat.Pops, "Pops"),
    ];
    string? animatedFor;
    string? builtFor;
    Timer? clock;

    protected override void OnInitialized()
    {
        Feed.Changed += OnLiveChanged;
        Feed.Start();
        Rebuild();
        clock = new Timer(_ => _ = InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    void OnLiveChanged() => _ = InvokeAsync(() => { Rebuild(); StateHasChanged(); });

    void Rebuild()
    {
        viewer = Feed.ViewerId;
        if (Feed.Current is not { } s)
        {
            me = null;
            dw = null;
            rows = [];
            sorted = [];
            ranks = new Dictionary<int, IReadOnlyDictionary<BoardStat, int>>();
            builtFor = null;
            return;
        }
        // Host data has only a file name, so the date is part of the key.
        builtFor = s.SavePath + "|" + s.Date + "|" + s.SavedUtc.Ticks;
        me = viewer is int v ? s.Countries.FirstOrDefault(c => c.Id == v) : null;
        dw = me is null ? null : s.Diplo?.GetValueOrDefault(me.Id);
        rows = viewer is int id ? LiveBoard.Build(s, id) : [];
        ranks = LiveBoard.Ranks(rows);
        sorted = LiveBoard.Sort(rows, sort, worstFirst);
    }

    void SetSort(BoardStat stat)
    {
        if (sort == stat) worstFirst = !worstFirst;
        else { sort = stat; worstFirst = false; }
        sorted = LiveBoard.Sort(rows, sort, worstFirst);
    }

    static string SortTip(BoardStat stat) => "Click to sort; click again to flip best/worst" + (LiveBoard.LowerIsBetter(stat) ? " (smaller is better)" : "");

    RenderFragment RankOf(BoardRow r, BoardStat stat) => ranks.TryGetValue(r.Id, out var m) && m.TryGetValue(stat, out var n)
        ? @<text> <span class="lr">#@n</span></text>
        : @<text></text>;

    RenderFragment MyRank(BoardStat stat) => me is not null && ranks.TryGetValue(me.Id, out var m) && m.TryGetValue(stat, out var n)
        ? @<text> <span class="lr">#@n of @rows.Count(x => x.Known)</span></text>
        : @<text></text>;

    async Task PickViewer(ChangeEventArgs e)
    {
        await Feed.SetViewerAsync(int.TryParse(e.Value?.ToString(), out var id) ? id : null);
        Rebuild();
    }

    static IEnumerable<(string Label, string From, DiploPart Part)> Parts(DiploBreakdown d) =>
    [
        ("Fleet power", "fleet power", d.Fleet),
        ("Pops", "pops", d.Pops),
        ("Economy", "economy power", d.Economy),
        ("Technology", "tech power", d.Tech),
    ];

    static string Pct(DiploBonus b) => DiploBonus.FormatPercent(b.Percent);

    static string BonusClass(DiploBonus b) => b.Percent < 0 ? "neg-bonus" : "pos-bonus";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (rows.Count == 0 || builtFor is null || animatedFor == builtFor + "|" + viewer + "|" + sort + "|" + worstFirst) return;
        animatedFor = builtFor + "|" + viewer + "|" + sort + "|" + worstFirst;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/livegame.js");
            await module.InvokeVoidAsync("animate", boardEl);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
    }

    static string? PlayerOf(GameSnapshot s, int id) => s.Players.FirstOrDefault(p => p.CountryId == id)?.Name;

    static string Initial(string name) => name.Length > 0 && name != "???" ? char.ToUpperInvariant(name[0]).ToString() : "?";

    static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalHours < 48) return $"{(int)span.TotalHours} h ago";
        return $"{(int)span.TotalDays} days ago";
    }

    static readonly Dictionary<string, string> Colors = new(StringComparer.OrdinalIgnoreCase)
    {
        ["red"] = "#b3261e", ["dark_red"] = "#7a1a14", ["burgundy"] = "#6d1b33", ["orange"] = "#d9761e", ["yellow"] = "#d6b31f",
        ["light_green"] = "#6fbf4a", ["green"] = "#2e7d32", ["dark_green"] = "#1e4d22", ["turquoise"] = "#1fa7a0", ["teal"] = "#18736e",
        ["light_blue"] = "#4aa3df", ["blue"] = "#2b5f9e", ["dark_blue"] = "#1a3566", ["indigo"] = "#3f3a8f", ["purple"] = "#6a3d9a",
        ["pink"] = "#d0679d", ["light_grey"] = "#a6adb5", ["grey"] = "#6b737c", ["dark_grey"] = "#3c4249", ["black"] = "#1b1d21",
        ["white"] = "#e8ebee", ["brown"] = "#7a5230", ["dark_brown"] = "#4d321c", ["beige"] = "#c8b28a",
    };

    static string FlagColor(CountryFlag? flag)
    {
        var name = flag?.Colors.FirstOrDefault(c => !string.Equals(c, "null", StringComparison.OrdinalIgnoreCase));
        return name is not null && Colors.TryGetValue(name, out var hex) ? hex : "#3a4a5c";
    }

    public async ValueTask DisposeAsync()
    {
        Feed.Changed -= OnLiveChanged;
        clock?.Dispose();
        if (module is not null)
        {
            try { await module.DisposeAsync(); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        }
    }
}
