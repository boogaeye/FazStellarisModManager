@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ModManagerService Manager
@inject ModIconCache Icons
@inject ModFileCache FileCache
@inject EditedModList State
@inject SessionService Session

@{
    var workshopIds = WorkshopIdsInList();
}
<div class="mods-page">
    <div class="mods-toolbar">
        <input class="list-name" @bind="listName" placeholder="List name" />
        <select @bind="selectedList" @bind:after="LoadSelected" disabled="@busy">
            <option value="">Load list…</option>
            @foreach (var l in savedLists)
            {
                <option value="@l.Name">@l.Name</option>
            }
        </select>
        <button @onclick="Save" disabled="@busy">Save list</button>
        <button @onclick="ImportCurrent" disabled="@busy">Import current</button>
        <button class="danger" @onclick="DeleteList" disabled="@(busy || !savedLists.Any(l => string.Equals(l.Name, listName.Trim(), StringComparison.OrdinalIgnoreCase)))">Delete list</button>
        <button @onclick="Refresh" disabled="@busy" title="Scan the mod folder again">Rescan mods</button>
        <span class="spacer"></span>
        <button class="primary" @onclick="Apply" disabled="@(busy || !loaded)">Apply</button>
        <button class="primary" @onclick="ApplyAndLaunch" disabled="@(busy || !loaded)">Apply &amp; Launch</button>
    </div>
    <div class="mods-toolbar">
        <button class="primary" @onclick="() => adding = true" disabled="@(busy || !loaded)">+ Add mods</button>
        <button @onclick="OpenUpdate" disabled="@(busy || !loaded || workshopIds.Count == 0)"
                title="Have Steam check this list's Workshop mods for updates and download them">⟳ Update mods (@workshopIds.Count)</button>
        <input class="list-filter" placeholder="Filter this list…" @bind="filter" @bind:event="oninput" />
        <span class="muted">@current.Count @(current.Count == 1 ? "mod" : "mods")</span>
    </div>

    @if (status is not null)
    {
        <p class="status @(error ? "error" : "")">@status</p>
    }
    @if (Manager.LibraryErrors.Count > 0)
    {
        <details class="library-errors">
            <summary>@Manager.LibraryErrors.Count descriptors could not be read</summary>
            <ul>
                @foreach (var err in Manager.LibraryErrors)
                {
                    <li>@err</li>
                }
            </ul>
        </details>
    }

    <ol class="modlist" @ref="listEl">
        @for (int i = 0; i < current.Count; i++)
        {
            var index = i;
            var e = current[i];
            if (filter.Length > 0 && !e.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)) continue;
            var mod = byKey.GetValueOrDefault(e.Key);
            var installed = Manager.IsInstalled(e);
            var isWorkshop = mod?.Source == ModSource.Workshop || (mod is null && ModKeys.WorkshopId(e.Key) is not null);
            var workshopId = ModMatcher.WorkshopIdOf(e.Key, mod?.RemoteId ?? e.RemoteId);
            <li class="mrow @(installed ? "" : "missing")" data-index="@index">
                <span class="grip" title="Drag to reorder">⋮⋮</span>
                <input @key="posVersion" class="pos" type="text" inputmode="numeric" value="@(index + 1)"
                       title="Type a position and press Enter" @onchange="ev => SetPosition(e, ev.Value)" />
                <ModIcon Uri="@(mod is null ? null : Icons.TryPeek(mod))" Name="@e.Name" />
                <div class="mname">
                    <div title="@e.Name">@e.Name</div>
                    <div class="sub">@e.DescriptorRel</div>
                </div>
                <span class="badge @(isWorkshop ? "workshop" : "local")">@(isWorkshop ? "Workshop" : "Local")</span>
                @if (!isWorkshop && workshopId is not null)
                {
                    <span class="badge local" title="This local mod is a copy of a Steam Workshop item">local copy of Workshop @workshopId</span>
                }
                @if (!installed)
                {
                    <span class="badge missing">not installed</span>
                }
                @if (ConflictsOf(e) is { IsHeavy: true } heavy)
                {
                    <button class="warnbadge" title="@heavy.Percent% of this mod's files are overwritten by mods later in the list"
                            @onclick="() => ToggleConflicts(e)">⚠ @heavy.Percent% overwritten</button>
                }
                @if (dupeByRel.GetValueOrDefault(e.DescriptorRel) is { } dupe)
                {
                    <button class="warnbadge" title="Another mod in your mod folder has the same name; Stellaris skips mods that share a name."
                            @onclick="() => OpenDupes([dupe], null)">⚠ Dupe conflict</button>
                }
                @if (workshopId is not null)
                {
                    <a class="button small" href="steam://url/CommunityFilePage/@workshopId" target="_blank" title="Open on the Steam Workshop">Workshop ↗</a>
                }
                <button class="small danger" title="Remove from list" @onclick="() => Remove(e)">✕</button>
            </li>
            @if (openConflicts.Contains(e) && ConflictsOf(e) is { IsHeavy: true } c)
            {
                <li class="conflict-panel">
                    <h4>@c.Overwritten of @c.Total files are overwritten by mods later in the list</h4>
                    @foreach (var g in c.Groups)
                    {
                        var winner = g.WinnerIndex < analyzed.Count ? analyzed[g.WinnerIndex] : null;
                        var winnerPos = winner is null ? -1 : IndexOf(winner);
                        var all = expandedGroups.Contains((e, g.WinnerIndex));
                        <div class="cgroup">by #@(winnerPos >= 0 ? (winnerPos + 1).ToString() : "?") @(winner?.Name ?? "a removed mod") (@g.Files.Count @(g.Files.Count == 1 ? "file" : "files"))</div>
                        <ul>
                            @foreach (var f in all ? g.Files : g.Files.Take(10))
                            {
                                <li>@f</li>
                            }
                        </ul>
                        @if (!all && g.Files.Count > 10)
                        {
                            var key = (e, g.WinnerIndex);
                            <button class="link" @onclick="() => expandedGroups.Add(key)">… @(g.Files.Count - 10) more</button>
                        }
                    }
                    <p class="muted">Usually means this mod has little effect here. Move it below those mods, or remove it.</p>
                </li>
            }
        }
    </ol>
</div>

@if (adding)
{
    <AddModsDialog Library="Manager.Library" InList="InListKeys()" Icons="Icons" ListName="@listName"
                   OnAdd="AddMods" OnClose="() => adding = false" />
}
@if (dupeGroups is not null)
{
    <DupeDialog Groups="dupeGroups" InListRels="ListRels()" ConfirmText="@(afterDupes is null ? "Keep selected" : "Fix and apply")"
                OnConfirm="ConfirmDupes" OnClose="() => { dupeGroups = null; afterDupes = null; }" />
}
@if (updating is not null)
{
    <UpdateModsDialog Mods="updating" ListName="@listName" FolderOf="ContentFolderOf" OnClose="CloseUpdate" />
}

@code {
    List<ModListEntry> current => State.Mods;
    List<string> disabledDlcs => State.DisabledDlcs;
    string listName { get => State.Name; set => State.Name = value; }
    bool loaded => State.Loaded;
    IReadOnlyList<ModList> savedLists = [];
    string? status;
    bool error;
    bool busy;
    bool confirmEmpty;
    string selectedList = "";

    string filter = "";
    ElementReference listEl;
    IJSObjectReference? dragModule;
    IJSObjectReference? dragHandle;
    DotNetObjectReference<Mods>? self;
    int posVersion;
    bool adding;
    IReadOnlyList<(ulong Id, string Name)>? updating; // the Update mods dialog is open for these
    Dictionary<string, InstalledMod> byKey = new(StringComparer.OrdinalIgnoreCase);
    CancellationTokenSource? iconRun;

    // Installed mods whose descriptor name another mod/*.mod shares (Stellaris skips them all), by descriptor path.
    Dictionary<string, DupeGroup> dupeByRel = new(StringComparer.OrdinalIgnoreCase);
    IReadOnlyList<DupeGroup>? dupeGroups;  // the dupe dialog is open with these groups
    Func<string?>? afterDupes;             // what runs after the renames (Apply); null when opened from a badge

    // File-conflict results for the list as it was when last analyzed (by entry reference); shown until a newer run finishes.
    Dictionary<ModListEntry, ModConflicts> conflicts = new(ReferenceEqualityComparer.Instance);
    List<ModListEntry> analyzed = [];
    readonly HashSet<ModListEntry> openConflicts = new(ReferenceEqualityComparer.Instance);
    readonly HashSet<(ModListEntry, int)> expandedGroups = [];
    CancellationTokenSource? conflictRun;

    // Re-checks file conflicts half a second after the last list change, off the UI thread.
    void ScheduleConflicts()
    {
        State.Touch();
        conflictRun?.Cancel();
        conflictRun?.Dispose();
        var run = conflictRun = new CancellationTokenSource();
        var snapshot = current.ToList();
        var mods = snapshot.Select(e => byKey.GetValueOrDefault(e.Key)).ToList();
        _ = CheckConflictsAsync(snapshot, mods, run.Token);
    }

    async Task CheckConflictsAsync(List<ModListEntry> snapshot, List<InstalledMod?> mods, CancellationToken ct)
    {
        try
        {
            await Task.Delay(500, ct);
            var results = await Task.Run(() =>
            {
                var files = mods.Select(m => m is null ? (IReadOnlyCollection<string>)[] : FileCache.Get(m.ContentPath)).ToList();
                ct.ThrowIfCancellationRequested();
                return ConflictAnalyzer.Analyze(files);
            }, ct);
            await InvokeAsync(() =>
            {
                if (ct.IsCancellationRequested) return;
                analyzed = snapshot;
                conflicts = new(ReferenceEqualityComparer.Instance);
                for (var i = 0; i < snapshot.Count; i++) conflicts.TryAdd(snapshot[i], results[i]);
                StateHasChanged();
            });
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException) { }
    }

    ModConflicts? ConflictsOf(ModListEntry e) => conflicts.GetValueOrDefault(e);

    void ToggleConflicts(ModListEntry e)
    {
        if (!openConflicts.Remove(e)) openConflicts.Add(e);
    }

    protected override async Task OnInitializedAsync()
    {
        status = "Scanning mods…";
        error = false;
        busy = true;
        await RunAsync(async () =>
        {
            await Manager.RefreshLibraryAsync();
            savedLists = Manager.Lists.LoadAll();
            var imported = !State.Loaded;
            if (imported) SetList(Manager.ImportCurrent("Current"));
            LibraryChanged();
            return imported
                ? $"Loaded {current.Count} enabled mods from dlc_load.json." + ErrorSuffix()
                : $"{current.Count} mods in '{listName}'." + ErrorSuffix();
        });
    }

    async Task Refresh()
    {
        status = "Scanning mods…";
        error = false;
        busy = true;
        await RunAsync(async () =>
        {
            await Manager.RefreshLibraryAsync();
            Icons.Refresh();
            FileCache.Clear();
            LibraryChanged();
            return $"Found {Manager.Library.Count} installed mods." + ErrorSuffix();
        });
    }

    // Rebuilds the key and dupe lookups and loads icons in the background: mods in the list first, 3 at a time.
    void LibraryChanged()
    {
        byKey = new(StringComparer.OrdinalIgnoreCase);
        foreach (var m in Manager.Library) byKey.TryAdd(m.Key, m);
        dupeByRel = new(StringComparer.OrdinalIgnoreCase);
        foreach (var g in DupeConflicts.Find(Manager.Library))
            foreach (var m in g.Mods) dupeByRel.TryAdd(m.DescriptorRel, g);

        iconRun?.Cancel();
        iconRun?.Dispose();
        var run = iconRun = new CancellationTokenSource();
        var inList = InListKeys();
        var mods = Manager.Library.OrderBy(m => inList.Contains(m.Key) ? 0 : 1).ToList();
        _ = LoadIconsAsync(mods, run.Token);
        ScheduleConflicts();
    }

    async Task LoadIconsAsync(List<InstalledMod> mods, CancellationToken ct)
    {
        long lastRender = Environment.TickCount64;
        try
        {
            await Parallel.ForEachAsync(mods, new ParallelOptions { MaxDegreeOfParallelism = 3, CancellationToken = ct }, async (m, _) =>
            {
                await Icons.GetAsync(m);
                // At most ~3 page updates a second while icons load, so scrolling stays smooth.
                var now = Environment.TickCount64;
                var last = Interlocked.Read(ref lastRender);
                if (now - last >= 350 && Interlocked.CompareExchange(ref lastRender, now, last) == last && !ct.IsCancellationRequested)
                    await InvokeAsync(StateHasChanged);
            });
            if (!ct.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException) { }
    }

    HashSet<string> InListKeys() => new(current.Select(e => e.Key), StringComparer.OrdinalIgnoreCase);

    HashSet<string> ListRels() => new(current.Select(e => e.DescriptorRel), StringComparer.OrdinalIgnoreCase);

    int IndexOf(ModListEntry e) => current.FindIndex(x => ReferenceEquals(x, e));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            self = DotNetObjectReference.Create(this);
            dragModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/modlist.js");
            dragHandle = await dragModule.InvokeAsync<IJSObjectReference>("attach", listEl, self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            (status, error) = ("Drag to reorder is unavailable: " + ex.Message, true);
        }
    }

    // Called from js/modlist.js when a dragged row is dropped: the row at from takes the place of the row at to.
    [JSInvokable]
    public Task MoveRow(int from, int to) => InvokeAsync(() =>
    {
        if (!ModListEditor.Move(current, from, to)) return;
        confirmEmpty = false;
        posVersion++;
        ScheduleConflicts();
        StateHasChanged();
    });

    void SetPosition(ModListEntry e, object? value)
    {
        posVersion++;   // recreate the number boxes so a rejected value doesn't stay typed in
        var index = IndexOf(e);
        if (index < 0) return;
        if (!int.TryParse(value?.ToString(), out var position))
        {
            (status, error) = ("Type a position number.", true);
            return;
        }
        var to = ModListEditor.MoveTo(current, index, position);
        if (to < 0) return;
        confirmEmpty = false;
        ScheduleConflicts();
        (status, error) = ($"Moved {current[to].Name} to position {to + 1}.", false);
    }

    void Remove(ModListEntry e)
    {
        var index = IndexOf(e);
        if (index < 0) return;
        confirmEmpty = false;
        current.RemoveAt(index);
        posVersion++;
        ScheduleConflicts();
    }

    void AddMods(IReadOnlyList<InstalledMod> mods)
    {
        adding = false;
        var added = ModListEditor.AddRange(current, mods);
        if (added > 0)
        {
            confirmEmpty = false;
            ScheduleConflicts();
        }
        (status, error) = ($"Added {added} {(added == 1 ? "mod" : "mods")}.", false);
    }

    IReadOnlyList<ulong> WorkshopIdsInList() => ModUpdater.WorkshopIds(new ModList(listName, current, disabledDlcs));

    void OpenUpdate()
    {
        var names = new Dictionary<ulong, string>();
        foreach (var e in current)
            if (ModKeys.WorkshopId(e.Key) is { } id) names.TryAdd(id, e.Name);
        var ids = WorkshopIdsInList();
        if (ids.Count > 0) updating = ids.Select(id => (id, names[id])).ToList();
    }

    // Where the library has the Workshop mod installed (null when it isn't).
    string? ContentFolderOf(ulong id) => byKey.GetValueOrDefault($"ugc:{id}")?.ContentPath;

    // After an update the mod folders may have changed: rescan them like "Rescan mods", then let the session compare
    // the new files. The status keeps the update's summary.
    async Task CloseUpdate(IReadOnlyList<ModUpdateResult>? results)
    {
        updating = null;
        if (results is null) return;
        var summary = ModUpdater.Summary(results);
        var failed = results.Any(r => r.Outcome == ModUpdateOutcome.Failed);
        status = "Scanning mods…";
        error = false;
        busy = true;
        await RunAsync(async () =>
        {
            await Manager.RefreshLibraryAsync();
            Icons.Refresh();
            FileCache.Clear();
            LibraryChanged();
            return summary + ErrorSuffix();
        });
        error |= failed;
        if (Session.Role == SessionRole.None || Session.IsBusy) return;

        var (shown, wasError) = (status, error);
        status = shown + " Rescanning for the session…";
        StateHasChanged();
        try
        {
            await Session.RescanAsync();
            (status, error) = (shown, wasError);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            (status, error) = ($"{shown} Rescanning for the session failed: {ex.Message}", true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        iconRun?.Cancel();
        iconRun?.Dispose();
        conflictRun?.Cancel();
        conflictRun?.Dispose();
        try
        {
            if (dragHandle is not null)
            {
                await dragHandle.InvokeVoidAsync("dispose");
                await dragHandle.DisposeAsync();
            }
            if (dragModule is not null) await dragModule.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        self?.Dispose();
    }

    string ErrorSuffix() =>
        Manager.LibraryErrors.Count > 0 ? $" ({Manager.LibraryErrors.Count} descriptors could not be read)" : "";

    ModList Build() => new(listName.Trim(), current.ToList(), disabledDlcs.ToList());

    void SetList(ModList list)
    {
        confirmEmpty = false;
        State.Set(list);
        ScheduleConflicts();
    }

    void ImportCurrent() => Run(() =>
    {
        selectedList = "";
        SetList(Manager.ImportCurrent("Current"));
        return $"Imported {current.Count} mods from dlc_load.json.";
    });

    void Save() => Run(() =>
    {
        Manager.Lists.Save(Build());
        savedLists = Manager.Lists.LoadAll();
        return $"Saved list '{listName.Trim()}'.";
    });

    void DeleteList() => Run(() =>
    {
        var name = listName.Trim();
        var deleted = Manager.Lists.Delete(name);
        savedLists = Manager.Lists.LoadAll();
        return deleted ? $"Deleted list '{name}'." : $"No saved list named '{name}'.";
    });

    void LoadSelected() => Run(() =>
    {
        var name = selectedList;
        selectedList = "";
        if (name.Length == 0) return null;
        SetList(Manager.Lists.Load(name) ?? throw new InvalidOperationException($"List '{name}' not found."));
        return $"Loaded list '{name}'.";
    });

    void Apply() => ApplyFixingDupes(DoApply);

    void ApplyAndLaunch() => ApplyFixingDupes(DoApplyAndLaunch);

    // When mods in the list share their name with another descriptor, Stellaris would skip them: ask which copies keep
    // the name and rename the others first (the dialog then runs the apply).
    void ApplyFixingDupes(Func<string?> apply)
    {
        var groups = Manager.DupesIn(Build());
        if (groups.Count > 0) OpenDupes(groups, apply);
        else Run(apply);
    }

    void OpenDupes(IReadOnlyList<DupeGroup> groups, Func<string?>? after) => (dupeGroups, afterDupes) = (groups, after);

    // Renames the unkept copies, then runs the apply that opened the dialog (if any); the status starts with the renames.
    void ConfirmDupes(IReadOnlyList<DupeChoice> choices)
    {
        var after = afterDupes;
        (dupeGroups, afterDupes) = (null, null);
        string? note = null;
        var warned = false;
        Run(() =>
        {
            var r = Manager.ResolveDupes(choices);
            LibraryChanged(); // the names changed: rebuild the badges
            note = $"Renamed {r.Renamed.Count} duplicate-named {(r.Renamed.Count == 1 ? "mod" : "mods")} so Stellaris loads them.";
            if (r.LauncherWarning is { } w) (note, warned) = (note + " " + w, true);
            return note;
        });
        if (note is null) return; // refused (e.g. the launcher is open) or failed: Run put the error in the status; nothing was applied
        if (after is not null)
        {
            status = null;
            Run(after);
            status = status is null ? note : note + " " + status;
        }
        if (warned) error = true;
    }

    string? DoApply()
    {
        if (current.Count == 0 && !confirmEmpty)
        {
            confirmEmpty = true;
            return "Click Apply again to write an empty mod list.";
        }
        confirmEmpty = false;
        var result = Manager.Apply(Build());
        var message = $"Applied {current.Count} mods to dlc_load.json" + (result.BackupPath is null ? "." : $" (backup: {Path.GetFileName(result.BackupPath)}).")
            + (result.LauncherPlaysetSet ? " Set as the active Paradox launcher playset." : "");
        if (result.LauncherWarning is { } warning)
        {
            (status, error) = (message + " " + warning, true);
            return null;
        }
        return message;
    }

    string? DoApplyAndLaunch()
    {
        if (Manager.Resolve().GameDir is null)
        {
            (status, error) = ("Stellaris install not found. Set the game folder in Settings.", true);
            return null;
        }
        if (current.Count == 0 && !confirmEmpty)
        {
            confirmEmpty = true;
            return "Click Apply again to write an empty mod list.";
        }
        confirmEmpty = false;
        var steamWarning = GameLauncher.IsSteamRunning() ? "" : " Warning: Steam does not appear to be running.";
        var result = Manager.Apply(Build());
        try
        {
            Manager.Launch();
        }
        catch (Exception ex)
        {
            (status, error) = ($"Applied, but launch failed: {ex.Message}", true);
            return null;
        }
        if (result.LauncherWarning is { } warning)
        {
            (status, error) = ("Applied and launched Stellaris." + steamWarning + " " + warning, true);
            return null;
        }
        return "Applied and launched Stellaris." + steamWarning;
    }

    async Task RunAsync(Func<Task<string?>> action)
    {
        try
        {
            var message = await action();
            if (message is not null) (status, error) = (message, false);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or ArgumentException or UnauthorizedAccessException
                                   or System.Text.Json.JsonException or System.ComponentModel.Win32Exception or InvalidDataException)
        {
            (status, error) = (ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    void Run(Func<string?> action)
    {
        try
        {
            var message = action();
            if (message is not null) (status, error) = (message, false);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or ArgumentException or UnauthorizedAccessException
                                   or System.Text.Json.JsonException or System.ComponentModel.Win32Exception or InvalidDataException)
        {
            (status, error) = (ex.Message, true);
        }
    }
}
