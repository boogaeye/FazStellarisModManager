@page "/"
@inject ModManagerService Manager

<div class="mods-page">
    <section class="panel">
        <header>
            <h2>Installed (@Manager.Library.Count)</h2>
            <input class="search" placeholder="Search…" @bind="filter" @bind:event="oninput" />
            <button @onclick="Refresh" disabled="@busy">Rescan</button>
        </header>
        <ul class="mod-list">
            @foreach (var m in FilteredLibrary)
            {
                var inList = current.Any(e => SameKey(e.Key, m.Key));
                <li class="@(inList ? "in-list" : "")">
                    <span class="badge @m.Source.ToString().ToLowerInvariant()">@(m.Source == ModSource.Workshop ? "Workshop" : "Local")</span>
                    <span class="name" title="@m.DescriptorRel">@m.Name</span>
                    @if (!inList)
                    {
                        <button class="small" @onclick="() => Add(m)">Add →</button>
                    }
                </li>
            }
        </ul>
    </section>

    <section class="panel">
        <header>
            <h2>List</h2>
            <input class="list-name" @bind="listName" placeholder="List name" />
            <select @bind="selectedList" @bind:after="LoadSelected" disabled="@busy">
                <option value="">Load list…</option>
                @foreach (var l in savedLists)
                {
                    <option value="@l.Name">@l.Name</option>
                }
            </select>
        </header>
        <div class="toolbar">
            <button @onclick="ImportCurrent" disabled="@busy">Import current</button>
            <button @onclick="Save" disabled="@busy">Save list</button>
            <button class="danger" @onclick="DeleteList" disabled="@(busy || !savedLists.Any(l => string.Equals(l.Name, listName.Trim(), StringComparison.OrdinalIgnoreCase)))">Delete list</button>
            <button class="primary" @onclick="Apply" disabled="@(busy || !loaded)">Apply</button>
            <button class="primary" @onclick="ApplyAndLaunch" disabled="@(busy || !loaded)">Apply &amp; Launch</button>
        </div>
        <ol class="mod-list ordered">
            @for (int i = 0; i < current.Count; i++)
            {
                var index = i;
                var e = current[i];
                var installed = Manager.IsInstalled(e);
                <li draggable="true" class="@(installed ? "" : "missing")"
                    @ondragstart="() => dragIndex = index" @ondragend="() => dragIndex = null"
                    @ondragover:preventDefault @ondrop:preventDefault @ondrop="() => Drop(index)">
                    <span class="order">@(index + 1)</span>
                    <span class="name" title="@e.DescriptorRel">@e.Name</span>
                    @if (!installed)
                    {
                        <span class="badge missing">not installed</span>
                    }
                    <button class="small" @onclick="() => Move(index, -1)" disabled="@(index == 0)">↑</button>
                    <button class="small" @onclick="() => Move(index, 1)" disabled="@(index == current.Count - 1)">↓</button>
                    <button class="small danger" @onclick="() => Remove(e)">✕</button>
                </li>
            }
        </ol>
    </section>
</div>

@if (status is not null)
{
    <p class="status @(error ? "error" : "")">@status</p>
}
@if (Manager.LibraryErrors.Count > 0)
{
    <details class="library-errors">
        <summary>@Manager.LibraryErrors.Count descriptors could not be read</summary>
        <ul>
            @foreach (var err in Manager.LibraryErrors)
            {
                <li>@err</li>
            }
        </ul>
    </details>
}

@code {
    List<ModListEntry> current = [];
    List<string> disabledDlcs = [];
    string listName = "Current";
    string filter = "";
    int? dragIndex;
    IReadOnlyList<ModList> savedLists = [];
    string? status;
    bool error;
    bool busy;
    bool loaded;
    bool confirmEmpty;
    string selectedList = "";

    IEnumerable<InstalledMod> FilteredLibrary =>
        Manager.Library.Where(m => filter.Length == 0 || m.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));

    static bool SameKey(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        status = "Scanning mods…";
        error = false;
        busy = true;
        await RunAsync(async () =>
        {
            await Manager.RefreshLibraryAsync();
            savedLists = Manager.Lists.LoadAll();
            SetList(Manager.ImportCurrent("Current"));
            loaded = true;
            return $"Loaded {current.Count} enabled mods from dlc_load.json." + ErrorSuffix();
        });
    }

    async Task Refresh()
    {
        status = "Scanning mods…";
        error = false;
        busy = true;
        await RunAsync(async () =>
        {
            await Manager.RefreshLibraryAsync();
            return $"Found {Manager.Library.Count} installed mods." + ErrorSuffix();
        });
    }

    string ErrorSuffix() =>
        Manager.LibraryErrors.Count > 0 ? $" ({Manager.LibraryErrors.Count} descriptors could not be read)" : "";

    void Add(InstalledMod m)
    {
        confirmEmpty = false;
        current.Add(new ModListEntry(m.Key, m.Name, m.DescriptorRel, m.RemoteId));
    }

    void Remove(ModListEntry e)
    {
        confirmEmpty = false;
        current.Remove(e);
    }

    void Move(int index, int delta)
    {
        var to = index + delta;
        if (index < 0 || index >= current.Count || to < 0 || to >= current.Count) return;
        confirmEmpty = false;
        var e = current[index];
        current.RemoveAt(index);
        current.Insert(index + delta, e);
    }

    void Drop(int target)
    {
        var from = dragIndex;
        dragIndex = null;
        if (from is not int f || f == target) return;
        if (f < 0 || f >= current.Count || target < 0 || target >= current.Count) return;
        confirmEmpty = false;
        var e = current[f];
        current.RemoveAt(f);
        current.Insert(target, e);
    }

    ModList Build() => new(listName.Trim(), current.ToList(), disabledDlcs.ToList());

    void SetList(ModList list)
    {
        confirmEmpty = false;
        listName = list.Name;
        current = list.Mods.ToList();
        disabledDlcs = list.DisabledDlcs.ToList();
    }

    void ImportCurrent() => Run(() =>
    {
        selectedList = "";
        SetList(Manager.ImportCurrent("Current"));
        loaded = true;
        return $"Imported {current.Count} mods from dlc_load.json.";
    });

    void Save() => Run(() =>
    {
        Manager.Lists.Save(Build());
        savedLists = Manager.Lists.LoadAll();
        return $"Saved list '{listName.Trim()}'.";
    });

    void DeleteList() => Run(() =>
    {
        var name = listName.Trim();
        var deleted = Manager.Lists.Delete(name);
        savedLists = Manager.Lists.LoadAll();
        return deleted ? $"Deleted list '{name}'." : $"No saved list named '{name}'.";
    });

    void LoadSelected() => Run(() =>
    {
        var name = selectedList;
        selectedList = "";
        if (name.Length == 0) return null;
        SetList(Manager.Lists.Load(name) ?? throw new InvalidOperationException($"List '{name}' not found."));
        loaded = true;
        return $"Loaded list '{name}'.";
    });

    void Apply() => Run(() =>
    {
        if (current.Count == 0 && !confirmEmpty)
        {
            confirmEmpty = true;
            return "Click Apply again to write an empty mod list.";
        }
        confirmEmpty = false;
        var backup = Manager.Apply(Build());
        return $"Applied {current.Count} mods to dlc_load.json" + (backup is null ? "." : $" (backup: {Path.GetFileName(backup)}).");
    });

    void ApplyAndLaunch() => Run(() =>
    {
        if (Manager.Resolve().GameDir is null)
        {
            (status, error) = ("Stellaris install not found. Set the game folder in Settings.", true);
            return null;
        }
        if (current.Count == 0 && !confirmEmpty)
        {
            confirmEmpty = true;
            return "Click Apply again to write an empty mod list.";
        }
        confirmEmpty = false;
        var steamWarning = GameLauncher.IsSteamRunning() ? "" : " Warning: Steam does not appear to be running.";
        Manager.Apply(Build());
        try
        {
            Manager.Launch();
        }
        catch (Exception ex)
        {
            (status, error) = ($"Applied, but launch failed: {ex.Message}", true);
            return null;
        }
        return "Applied and launched Stellaris." + steamWarning;
    });

    async Task RunAsync(Func<Task<string?>> action)
    {
        try
        {
            var message = await action();
            if (message is not null) (status, error) = (message, false);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or ArgumentException or UnauthorizedAccessException
                                   or System.Text.Json.JsonException or System.ComponentModel.Win32Exception or InvalidDataException)
        {
            (status, error) = (ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    void Run(Func<string?> action)
    {
        try
        {
            var message = action();
            if (message is not null) (status, error) = (message, false);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or ArgumentException or UnauthorizedAccessException
                                   or System.Text.Json.JsonException or System.ComponentModel.Win32Exception or InvalidDataException)
        {
            (status, error) = (ex.Message, true);
        }
    }
}
