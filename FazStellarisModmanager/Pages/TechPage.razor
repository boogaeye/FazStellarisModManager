@page "/tech"
@using System.Globalization
@implements IDisposable
@inject TechTreeService Tree

<div class="tech-page">
    <div class="toolbar">
        <label class="inline">Mod list
            <select @bind="choiceIndex" @bind:after="Build" disabled="@Tree.IsBuilding">
                @for (int i = 0; i < choices.Count; i++)
                {
                    <option value="@i">@choices[i].Label</option>
                }
            </select>
        </label>
        <button @onclick="Build" disabled="@Tree.IsBuilding">Rebuild</button>
        @if (Tree.Current is { } shown)
        {
            <span class="status">Showing: @shown.Label</span>
        }
        @if (Tree.Progress is { } progress)
        {
            <span class="status">@progress</span>
        }
        else if (status is not null)
        {
            <span class="status @(error ? "error" : "")">@status</span>
        }
    </div>

    @if (Tree.Current is { } tree)
    {
        var db = tree.Database;
        if (db.Warnings.Count > 0)
        {
            <details class="warnings">
                <summary>@db.Warnings.Count warning(s) while reading the mods</summary>
                <ul>@foreach (var w in db.Warnings.Take(200)) { <li>@w</li> }</ul>
            </details>
        }

        <div class="tabs-row">
            @foreach (var (label, area) in Tabs)
            {
                var a = area;
                <button class="tab @(tab == a ? "on" : "")" @onclick="() => tab = a">@label <span class="n">@db.Count(a)</span></button>
            }
        </div>

        <div class="filters">
            <input class="search" placeholder="Search name or id…" @bind="searchInput" @bind:event="oninput" @bind:after="SearchChanged" />
            <select @bind="tierText">
                <option value="">Tier: all</option>
                @foreach (var t in db.Tiers)
                {
                    <option value="@t">Tier @t</option>
                }
            </select>
            <select @bind="category">
                <option value="">Category: all</option>
                @foreach (var c in db.Categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
            <select @bind="source">
                <option value="">Source: any</option>
                @foreach (var s in db.SourceNames)
                {
                    <option value="@s">@s</option>
                }
            </select>
            <button class="chip @(rare ? "on" : "")" @onclick="() => rare = !rare">Rare</button>
            <button class="chip @(dangerous ? "on" : "")" @onclick="() => dangerous = !dangerous">Dangerous</button>
            <button class="chip @(repeatable ? "on" : "")" @onclick="() => repeatable = !repeatable">Repeatable</button>
            <button class="chip @(starting ? "on" : "")" @onclick="() => starting = !starting">Starting</button>
            <button class="chip @(changed ? "on" : "")" @onclick="() => changed = !changed">Changed by mods</button>
        </div>

        <div class="tech-main">
            <div class="tech-list">
                @{ var results = db.Query(Filter).ToList(); }
                <div class="status small">@results.Count technologies</div>
                @foreach (var t in results.Take(MaxRows))
                {
                    var tech = t;
                    <div @key="tech.Key" class="tech-row @(tech.Key == selectedKey ? "sel" : "")" @onclick="() => selectedKey = tech.Key">
                        <TechIcon Uri="@Tree.IconUri(tech)" Size="24" />
                        <div class="grow">
                            <div class="name">@tech.Name</div>
                            <div class="src @(tech.ChangedByMods ? "mod" : "")">T@(TierText(tech)) · @tech.Source.SourceName</div>
                        </div>
                    </div>
                }
                @if (results.Count > MaxRows)
                {
                    <div class="status small">… and @(results.Count - MaxRows) more. Narrow the search.</div>
                }
            </div>

            <div class="tech-focus">
                <div class="view-switch">
                    <span class="seg">
                        <button class="@(wholeTree ? "" : "on")" @onclick="() => wholeTree = false">Focus</button>
                        <button class="@(wholeTree ? "on" : "")" @onclick="() => wholeTree = true">Whole tree</button>
                    </span>
                    @if (wholeTree)
                    {
                        <span class="small">Drag to pan · wheel to zoom · right-click: researched · Shift+click: route target</span>
                    }
                </div>
                @if (wholeTree || targets.Count > 0)
                {
                    <RouteBar Database="db" Targets="targets" Route="route" ResearchedCount="researched.Count"
                              OnSelect="key => selectedKey = key" OnRemoveTarget="ToggleTarget" OnClearRoute="ClearRoute" OnUnresearchAll="UnresearchAll" />
                }
                @if (wholeTree)
                {
                    <TechOverviewView Overview="OverviewFor(db)" Database="db" IconUri="Tree.IconUri" IconVersion="Tree.IconCount"
                                      SelectedKey="selectedKey" Route="route" Targets="targets" Researched="researched"
                                      OnSelect="key => selectedKey = key" OnToggleResearched="ToggleResearched" OnToggleTarget="ToggleTarget" />
                }
                else if (selectedKey is not null && db.Techs.TryGetValue(selectedKey, out var sel))
                {
                    <div class="ghead">
                        <span>← Requires</span>
                        <b>@sel.Name</b>
                        <span>Leads to →</span>
                        <label class="inline">Depth
                            <select @bind="depth">
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                            </select>
                        </label>
                    </div>
                    <div class="graph-scroll">
                        <TechGraphView Graph="TechGraphLayout.Build(db, sel.Key, depth)" Database="db" IconUri="Tree.IconUri" OnSelect="key => selectedKey = key" />
                    </div>
                }
                else
                {
                    <p class="status">Pick a technology on the left.</p>
                }
            </div>

            <aside class="tech-sidebar">
                @if (selectedKey is not null && db.Techs.TryGetValue(selectedKey, out var side))
                {
                    <TechSidebar Tech="side" Database="db" Tree="Tree" OnSelect="key => selectedKey = key"
                                 Targets="targets" Researched="researched" Route="route"
                                 OnToggleTarget="ToggleTarget" OnToggleResearched="ToggleResearched" />
                }
                else
                {
                    <p class="status">Pick a technology to see its details.</p>
                }
            </aside>
        </div>
    }
</div>

@code {
    const int MaxRows = 200;

    static readonly (string Label, TechArea? Area)[] Tabs =
        [("All", null), ("Physics", TechArea.Physics), ("Society", TechArea.Society), ("Engineering", TechArea.Engineering)];

    IReadOnlyList<TechTreeChoice> choices = [];
    int choiceIndex;
    TechArea? tab;
    string search = "", searchInput = "", tierText = "", category = "", source = "";
    bool rare, dangerous, repeatable, starting, changed;
    string? selectedKey;
    int depth = 2;
    string? status;
    bool error;
    CancellationTokenSource? searchCts;
    bool wholeTree;
    TechTree? stateFor;   // the tree whose saved research state is loaded
    HashSet<string> researched = new(StringComparer.OrdinalIgnoreCase);
    HashSet<string> targets = new(StringComparer.OrdinalIgnoreCase);
    ResearchRoute route = ResearchRoute.Empty;
    TechOverview? overview;
    TechDatabase? overviewDb;

    TechOverview OverviewFor(TechDatabase db)
    {
        if (!ReferenceEquals(overviewDb, db)) (overview, overviewDb) = (TechOverviewLayout.Build(db), db);
        return overview!;
    }

    void SyncResearchState()
    {
        if (Tree.Current is not { } tree || ReferenceEquals(stateFor, tree)) return;
        stateFor = tree;
        var warnings = new List<string>();
        var state = Tree.Research.Load(tree.Label, warnings);
        researched = new HashSet<string>(state.Researched, StringComparer.OrdinalIgnoreCase);
        targets = new HashSet<string>(state.Targets, StringComparer.OrdinalIgnoreCase);
        RecomputeRoute();
        if (warnings.Count > 0) (status, error) = (warnings[0], true);
    }

    void RecomputeRoute() =>
        route = targets.Count == 0 || Tree.Current is null ? ResearchRoute.Empty : ResearchPlan.Build(Tree.Current.Database, targets, researched);

    // New set instances on every change: the map compares them by reference to decide whether to redraw.
    void ChangeResearch(Action<HashSet<string>, HashSet<string>> change)
    {
        var r = new HashSet<string>(researched, StringComparer.OrdinalIgnoreCase);
        var t = new HashSet<string>(targets, StringComparer.OrdinalIgnoreCase);
        change(r, t);
        (researched, targets) = (r, t);
        RecomputeRoute();
        if (stateFor is null) return;
        try
        {
            Tree.Research.Save(stateFor.Label, new ResearchState([.. researched], [.. targets]));
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            (status, error) = ($"Could not save research progress: {ex.Message}", true);
        }
    }

    void ToggleResearched(string key) => ChangeResearch((r, _) => { if (!r.Remove(key)) r.Add(key); });
    void ToggleTarget(string key) => ChangeResearch((_, t) => { if (!t.Remove(key)) t.Add(key); });
    void ClearRoute() => ChangeResearch((_, t) => t.Clear());
    void UnresearchAll() => ChangeResearch((r, _) => r.Clear());

    TechFilter Filter => new(
        search,
        tab,
        int.TryParse(tierText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var t) ? t : null,
        category.Length == 0 ? null : category,
        source.Length == 0 ? null : source,
        rare, dangerous, repeatable, starting, changed);

    protected override async Task OnInitializedAsync()
    {
        Tree.Changed += OnTreeChanged;
        choices = Tree.Choices();
        if (Tree.Current is { } current)
        {
            choiceIndex = Math.Max(0, choices.ToList().FindIndex(c => c.Label == current.Label));
            selectedKey = current.Database.Techs.Values.FirstOrDefault(t => t.IsStart)?.Key;
            SyncResearchState();
        }
        else if (!Tree.IsBuilding)
        {
            await Build();
        }
    }

    void OnTreeChanged() => _ = InvokeAsync(() =>
    {
        if (selectedKey is null && Tree.Current is { } current)
            selectedKey = current.Database.Techs.Values.FirstOrDefault(t => t.IsStart)?.Key;
        SyncResearchState();
        StateHasChanged();
    });

    async Task SearchChanged()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        var cts = searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(200, cts.Token);
        }
        catch (OperationCanceledException) { return; }
        search = searchInput;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Tree.Changed -= OnTreeChanged;
        searchCts?.Cancel();
        searchCts?.Dispose();
    }

    async Task Build()
    {
        (status, error) = (null, false);
        try
        {
            var selectedLabel = choices.Count > 0 ? choices[Math.Clamp(choiceIndex, 0, choices.Count - 1)].Label : TechTreeService.CurrentGameLabel;
            choices = Tree.Choices();
            choiceIndex = Math.Max(0, choices.ToList().FindIndex(c => c.Label == selectedLabel));
            await Tree.BuildAsync(choices[choiceIndex]);
            SyncResearchState();
            var db = Tree.Current!.Database;
            status = $"{db.Techs.Count} technologies from {Tree.Current.Sources.Count} sources.";
            if (selectedKey is null || !db.Techs.ContainsKey(selectedKey))
                selectedKey = db.Techs.Values.FirstOrDefault(t => t.IsStart)?.Key ?? db.Techs.Keys.FirstOrDefault();
            if (tierText.Length > 0 && !db.Tiers.Any(t => t.ToString(CultureInfo.InvariantCulture) == tierText)) tierText = "";
            if (category.Length > 0 && !db.Categories.Contains(category, StringComparer.OrdinalIgnoreCase)) category = "";
            if (source.Length > 0 && !db.SourceNames.Contains(source)) source = "";
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or UnauthorizedAccessException
                                   or InvalidDataException or OperationCanceledException or ObjectDisposedException or ArgumentException)
        {
            (status, error) = (ex.Message, true);
            if (Tree.Current is { } cur)
            {
                var idx = choices.ToList().FindIndex(c => c.Label == cur.Label);
                if (idx >= 0) choiceIndex = idx;
            }
        }
    }

    static string TierText(Tech t) => t.IsRepeatable ? "R" : t.Tier?.ToString(CultureInfo.InvariantCulture) ?? "?";
}
