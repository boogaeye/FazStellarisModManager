@page "/tech"
@using System.Globalization
@implements IDisposable
@inject TechTreeService Tree

<div class="tech-page">
    <div class="toolbar">
        <label class="inline">Mod list
            <select @bind="choiceIndex" @bind:after="Build" disabled="@Tree.IsBuilding">
                @for (int i = 0; i < choices.Count; i++)
                {
                    <option value="@i">@choices[i].Label</option>
                }
            </select>
        </label>
        <button @onclick="Build" disabled="@Tree.IsBuilding">Rebuild</button>
        @if (Tree.Progress is { } progress)
        {
            <span class="status">@progress</span>
        }
        else if (status is not null)
        {
            <span class="status @(error ? "error" : "")">@status</span>
        }
    </div>

    @if (Tree.Current is { } tree)
    {
        var db = tree.Database;
        if (db.Warnings.Count > 0)
        {
            <details class="warnings">
                <summary>@db.Warnings.Count warning(s) while reading the mods</summary>
                <ul>@foreach (var w in db.Warnings.Take(200)) { <li>@w</li> }</ul>
            </details>
        }

        <div class="tabs-row">
            @foreach (var (label, area) in Tabs)
            {
                var a = area;
                <button class="tab @(tab == a ? "on" : "")" @onclick="() => tab = a">@label <span class="n">@db.Count(a)</span></button>
            }
        </div>

        <div class="filters">
            <input class="search" placeholder="Search name or id…" @bind="search" @bind:event="oninput" />
            <select @bind="tierText">
                <option value="">Tier: all</option>
                @foreach (var t in db.Tiers)
                {
                    <option value="@t">Tier @t</option>
                }
            </select>
            <select @bind="category">
                <option value="">Category: all</option>
                @foreach (var c in db.Categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
            <select @bind="source">
                <option value="">Source: any</option>
                @foreach (var s in db.SourceNames)
                {
                    <option value="@s">@s</option>
                }
            </select>
            <button class="chip @(rare ? "on" : "")" @onclick="() => rare = !rare">Rare</button>
            <button class="chip @(dangerous ? "on" : "")" @onclick="() => dangerous = !dangerous">Dangerous</button>
            <button class="chip @(repeatable ? "on" : "")" @onclick="() => repeatable = !repeatable">Repeatable</button>
            <button class="chip @(starting ? "on" : "")" @onclick="() => starting = !starting">Starting</button>
            <button class="chip @(changed ? "on" : "")" @onclick="() => changed = !changed">Changed by mods</button>
        </div>

        <div class="tech-main">
            <div class="tech-list">
                @{ var results = db.Query(Filter).ToList(); }
                <div class="status small">@results.Count technologies</div>
                @foreach (var t in results.Take(MaxRows))
                {
                    var tech = t;
                    <div class="tech-row @(tech.Key == selectedKey ? "sel" : "")" @onclick="() => selectedKey = tech.Key">
                        <TechIcon Uri="@Tree.IconUri(tech)" Size="24" />
                        <div class="grow">
                            <div class="name">@tech.Name</div>
                            <div class="src @(tech.ChangedByMods ? "mod" : "")">T@(TierText(tech)) · @tech.Source.SourceName</div>
                        </div>
                    </div>
                }
                @if (results.Count > MaxRows)
                {
                    <div class="status small">… and @(results.Count - MaxRows) more. Narrow the search.</div>
                }
            </div>

            <div class="tech-focus">
                @if (selectedKey is not null && db.Techs.TryGetValue(selectedKey, out var sel))
                {
                    <div class="ghead">
                        <span>← Requires</span>
                        <b>@sel.Name</b>
                        <span>Leads to →</span>
                        <label class="inline">Depth
                            <select @bind="depth">
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                            </select>
                        </label>
                    </div>
                    <div class="graph-scroll">
                        <TechGraphView Graph="TechGraphLayout.Build(db, sel.Key, depth)" Database="db" IconUri="Tree.IconUri" OnSelect="key => selectedKey = key" />
                    </div>

                    <div class="tech-detail">
                        <TechIcon Uri="@Tree.IconUri(sel)" Size="52" />
                        <div class="grow">
                            <div class="title">@sel.Name <span class="muted small">@sel.Key</span></div>
                            <div class="tags">
                                <span class="tag">@sel.Area</span>
                                @if (sel.Category is not null) { <span class="tag">@sel.Category</span> }
                                <span class="tag">Tier @TierText(sel)</span>
                                <span class="tag">Cost @sel.Cost</span>
                                @if (sel.IsStart) { <span class="tag">Starting</span> }
                                @if (sel.IsRare) { <span class="tag rare">Rare</span> }
                                @if (sel.IsDangerous) { <span class="tag danger">Dangerous</span> }
                                @if (sel.IsRepeatable) { <span class="tag">Repeatable</span> }
                                @foreach (var dlc in sel.Dlcs) { <span class="tag dlc">DLC: @dlc</span> }
                            </div>
                            @if (sel.Description is not null)
                            {
                                <p class="desc">@sel.Description</p>
                            }
                            <div><span class="muted">Source:</span> <span class="@(sel.ChangedByMods ? "modtext" : "")">@sel.Source.SourceName</span> <span class="muted">· @sel.Source.File</span></div>
                            @if (sel.Overridden.Count > 0)
                            {
                                <div><span class="muted">Overrides:</span> @string.Join(", ", sel.Overridden.Select(o => $"{o.SourceName} ({Path.GetFileName(o.File)})"))</div>
                            }
                            <div class="path">
                                <span class="muted">Path from start:</span>
                                @{ var path = db.PathFromStart(sel.Key); }
                                @for (int i = 0; i < path.Count; i++)
                                {
                                    var step = path[i];
                                    if (i > 0) { <span class="muted"> → </span> }
                                    <a class="link" @onclick="() => selectedKey = step.Key">@step.Name</a>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="status">Pick a technology on the left.</p>
                }
            </div>
        </div>
    }
</div>

@code {
    const int MaxRows = 300;

    static readonly (string Label, TechArea? Area)[] Tabs =
        [("All", null), ("Physics", TechArea.Physics), ("Society", TechArea.Society), ("Engineering", TechArea.Engineering)];

    IReadOnlyList<TechTreeChoice> choices = [];
    int choiceIndex;
    TechArea? tab;
    string search = "", tierText = "", category = "", source = "";
    bool rare, dangerous, repeatable, starting, changed;
    string? selectedKey;
    int depth = 2;
    string? status;
    bool error;

    TechFilter Filter => new(
        search,
        tab,
        int.TryParse(tierText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var t) ? t : null,
        category.Length == 0 ? null : category,
        source.Length == 0 ? null : source,
        rare, dangerous, repeatable, starting, changed);

    protected override async Task OnInitializedAsync()
    {
        Tree.Changed += OnTreeChanged;
        choices = Tree.Choices();
        if (Tree.Current is { } current)
        {
            choiceIndex = Math.Max(0, choices.ToList().FindIndex(c => c.Label == current.Label));
            selectedKey = current.Database.Techs.Values.FirstOrDefault(t => t.IsStart)?.Key;
        }
        else
        {
            await Build();
        }
    }

    void OnTreeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Tree.Changed -= OnTreeChanged;

    async Task Build()
    {
        (status, error) = (null, false);
        try
        {
            var selectedLabel = choices.Count > 0 ? choices[Math.Clamp(choiceIndex, 0, choices.Count - 1)].Label : TechTreeService.CurrentGameLabel;
            choices = Tree.Choices();
            choiceIndex = Math.Max(0, choices.ToList().FindIndex(c => c.Label == selectedLabel));
            await Tree.BuildAsync(choices[choiceIndex]);
            var db = Tree.Current!.Database;
            status = $"{db.Techs.Count} technologies from {Tree.Current.Sources.Count} sources.";
            if (selectedKey is null || !db.Techs.ContainsKey(selectedKey))
                selectedKey = db.Techs.Values.FirstOrDefault(t => t.IsStart)?.Key ?? db.Techs.Keys.FirstOrDefault();
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or UnauthorizedAccessException
                                   or InvalidDataException or OperationCanceledException or ObjectDisposedException)
        {
            (status, error) = (ex.Message, true);
        }
    }

    static string TierText(Tech t) => t.IsRepeatable ? "R" : t.Tier?.ToString(CultureInfo.InvariantCulture) ?? "?";
}
