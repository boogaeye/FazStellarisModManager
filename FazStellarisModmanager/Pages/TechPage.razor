@page "/tech"
@using System.Globalization
@using FazStellarisModmanager.Core.Conditions
@implements IDisposable
@inject TechTreeService Tree
@inject LiveFeed Feed

<div class="tech-page">
    <div class="toolbar">
        <label class="inline">Mod list
            <select @bind="choiceIndex" @bind:after="Build" disabled="@Tree.IsBuilding">
                @for (int i = 0; i < choices.Count; i++)
                {
                    <option value="@i">@choices[i].Label</option>
                }
            </select>
        </label>
        <button @onclick="Build" disabled="@Tree.IsBuilding">Rebuild</button>
        @if (Tree.Current is { } shown)
        {
            <span class="status">Showing: @shown.Label</span>
        }
        @if (Tree.Progress is { } progress)
        {
            <span class="status">@progress</span>
        }
        else if (status is not null)
        {
            <span class="status @(error ? "error" : "")">@status</span>
        }
    </div>

    @if (Tree.Current is { } tree)
    {
        var db = tree.Database;
        if (db.Warnings.Count > 0)
        {
            <details class="warnings">
                <summary>@db.Warnings.Count warning(s) while reading the mods</summary>
                <ul>@foreach (var w in db.Warnings.Take(200)) { <li>@w</li> }</ul>
            </details>
        }

        <div class="tabs-row">
            @foreach (var (label, area) in Tabs)
            {
                var a = area;
                <button class="tab @(tab == a ? "on" : "")" @onclick="() => tab = a">@label <span class="n">@db.Count(a)</span></button>
            }
        </div>

        <div class="filters">
            <input class="search" placeholder="Search name, id or effect (e.g. energy)…" @bind="searchInput" @bind:event="oninput" @bind:after="SearchChanged" />
            <select @bind="tierText">
                <option value="">Tier: all</option>
                @foreach (var t in db.Tiers)
                {
                    <option value="@t">Tier @t</option>
                }
            </select>
            <select @bind="category">
                <option value="">Category: all</option>
                @foreach (var c in db.Categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
            <select @bind="source">
                <option value="">Source: any</option>
                @foreach (var s in db.SourceNames)
                {
                    <option value="@s">@s</option>
                }
            </select>
            <button class="chip @(rare ? "on" : "")" @onclick="() => rare = !rare">Rare</button>
            <button class="chip @(dangerous ? "on" : "")" @onclick="() => dangerous = !dangerous">Dangerous</button>
            <button class="chip @(repeatable ? "on" : "")" @onclick="() => repeatable = !repeatable">Repeatable</button>
            <button class="chip @(starting ? "on" : "")" @onclick="() => starting = !starting">Starting</button>
            <button class="chip @(changed ? "on" : "")" @onclick="() => changed = !changed">Changed by mods</button>
        </div>

        <div class="tech-main">
            <div class="tech-list">
                @{ var results = db.Query(Filter).ToList(); }
                <div class="status small">@results.Count technologies</div>
                @foreach (var t in results.Take(MaxRows))
                {
                    var tech = t;
                    <div @key="tech.Key" class="tech-row @(tech.Key == selectedKey ? "sel" : "") @(researched.Contains(tech.Key) ? "done" : "")" @onclick="() => selectedKey = tech.Key">
                        <TechIcon Uri="@Tree.IconUri(tech)" Size="24" />
                        <div class="grow">
                            <div class="name">@if (researched.Contains(tech.Key)) { <span class="done-mark">✓</span> }@tech.Name</div>
                            <div class="src @(tech.ChangedByMods ? "mod" : "")">T@(TierText(tech)) · @tech.Source.SourceName</div>
                            @if (search.Trim().Length > 0 && !TechDatabase.NameMatches(tech, search.Trim()))
                            {
                                var hits = db.EffectMatches(tech, search);
                                @foreach (var hit in hits.Take(2))
                                {
                                    <div class="hit">↳ @hit</div>
                                }
                                @if (hits.Count > 2)
                                {
                                    <div class="hit">↳ +@(hits.Count - 2) more</div>
                                }
                            }
                        </div>
                    </div>
                }
                @if (results.Count > MaxRows)
                {
                    <div class="status small">… and @(results.Count - MaxRows) more. Narrow the search.</div>
                }
            </div>

            <div class="tech-focus">
                <div class="view-switch">
                    <span class="seg">
                        <button class="@(wholeTree ? "" : "on")" @onclick="() => wholeTree = false">Focus</button>
                        <button class="@(wholeTree ? "on" : "")" @onclick="() => wholeTree = true">Whole tree</button>
                    </span>
                    @if (wholeTree)
                    {
                        <span class="small">Drag to pan · wheel to zoom · Researched techs come from Live Game · Shift+click: route target</span>
                    }
                    @if (Feed.Current is { } liveSnap && Feed.ViewerId is not null)
                    {
                        <span class="small">Researched: @(researched.Count(k => db.Techs.ContainsKey(k))) techs from Live Game (@liveSnap.Date)</span>
                    }
                    else
                    {
                        <span class="small">No live game data: open the Live Game tab with a save, or join a session.</span>
                    }
                </div>
                @if (researchMessage is not null)
                {
                    <div class="status error">@researchMessage</div>
                }
                @{ var researchedInTree = researched.Count(k => db.Techs.ContainsKey(k)); }
                @if (wholeTree || targets.Count > 0 || researchedInTree > 0)
                {
                    <RouteBar Database="db" Targets="targets" Route="route"
                              OnSelect="key => selectedKey = key" OnRemoveTarget="RemoveTarget" OnClearRoute="ClearRoute" />
                }
                @if (wholeTree)
                {
                    @* While icons load, redraw the map every 250 icons rather than on every progress tick. *@
                    <TechOverviewView Overview="OverviewFor(db)" Database="db" IconUri="Tree.IconUri"
                                      IconVersion="@(Tree.IconsReady.IsCompleted ? -1 : Tree.IconCount / 250)"
                                      SelectedKey="selectedKey" Route="route" Targets="targets" Researched="researched"
                                      OnSelect="key => selectedKey = key" OnToggleTarget="ToggleTarget" />
                }
                else if (selectedKey is not null && db.Techs.TryGetValue(selectedKey, out var sel))
                {
                    <div class="ghead">
                        <span>← Requires</span>
                        <b>@sel.Name</b>
                        <span>Leads to →</span>
                        <label class="inline">Depth
                            <select @bind="depth">
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                            </select>
                        </label>
                    </div>
                    <div class="graph-scroll">
                        <TechGraphView Graph="TechGraphLayout.Build(db, sel.Key, depth)" Database="db" Researched="researched" IconUri="Tree.IconUri" OnSelect="key => selectedKey = key" />
                    </div>
                }
                else
                {
                    <p class="status">Pick a technology on the left.</p>
                }
            </div>

            <aside class="tech-sidebar">
                @if (selectedKey is not null && db.Techs.TryGetValue(selectedKey, out var side))
                {
                    <TechSidebar Tech="side" Database="db" Tree="Tree" OnSelect="key => selectedKey = key"
                                 Targets="targets" Researched="researched" Route="route"
                                 OnToggleTarget="ToggleTarget" Facts="facts" />
                }
                else
                {
                    <p class="status">Pick a technology to see its details.</p>
                }
            </aside>
        </div>
    }
</div>

@code {
    const int MaxRows = 200;

    static readonly (string Label, TechArea? Area)[] Tabs =
        [("All", null), ("Physics", TechArea.Physics), ("Society", TechArea.Society), ("Engineering", TechArea.Engineering)];

    IReadOnlyList<TechTreeChoice> choices = [];
    int choiceIndex;
    TechArea? tab;
    string search = "", searchInput = "", tierText = "", category = "", source = "";
    bool rare, dangerous, repeatable, starting, changed;
    string? selectedKey;
    int depth = 2;
    string? status;
    bool error;
    CancellationTokenSource? searchCts;
    bool wholeTree;
    TechTree? stateFor;   // the tree whose saved research state is loaded
    string? researchMessage;   // load warning or save error for the research state; shown under the view switch
    HashSet<string> researched = new(StringComparer.OrdinalIgnoreCase);
    HashSet<string> targets = new(StringComparer.OrdinalIgnoreCase);
    ResearchRoute route = ResearchRoute.Empty;
    TechOverview? overview;
    TechDatabase? overviewDb;

    TechOverview OverviewFor(TechDatabase db)
    {
        if (!ReferenceEquals(overviewDb, db)) (overview, overviewDb) = (TechOverviewLayout.Build(db), db);
        return overview!;
    }

    // A rebuild of the same mod list keeps the in-memory sets (they are already saved); another list loads its own file.
    void SyncResearchState()
    {
        if (Tree.Current is not { } tree || ReferenceEquals(stateFor, tree)) return;
        var sameList = stateFor is not null && stateFor.Label == tree.Label;
        stateFor = tree;
        if (!sameList)
        {
            var warnings = new List<string>();
            var state = Tree.Research.Load(tree.Label, warnings);
            targets = new HashSet<string>(state.Targets, StringComparer.OrdinalIgnoreCase);
            researchMessage = warnings.Count > 0 ? warnings[0] : null;
        }
        UpdateResearched();
    }

    // The viewer's empire for the ✓/✗ marks, rebuilt only when the snapshot or the viewer changed. Null when the live data lacks
    // what the conditions need (an older host, a country that was not read).
    EmpireFacts? facts;
    GameSnapshot? factsSnapshot;
    int? factsViewer;

    void UpdateFacts()
    {
        var snap = Feed.Current;
        var viewer = Feed.ViewerId;
        if (ReferenceEquals(snap, factsSnapshot) && viewer == factsViewer) return;
        (factsSnapshot, factsViewer) = (snap, viewer);
        facts = snap is not null && viewer is int id && snap.Countries.FirstOrDefault(c => c.Id == id) is { Holdings: not null, Flags: not null } me
                && snap.GlobalFlags is not null
            ? EmpireFacts.From(me, snap, snap.Players.Any(p => p.CountryId == id))
            : null;
    }

    // Researched techs come from the live game; the route is rebuilt only when that set changed.
    void UpdateResearched()
    {
        UpdateFacts();
        var live = Feed.ResearchedTechs;
        if (!live.SetEquals(researched)) researched = new HashSet<string>(live, StringComparer.OrdinalIgnoreCase);
        RecomputeRoute();
    }

    void RecomputeRoute() =>
        route = targets.Count == 0 || stateFor is null ? ResearchRoute.Empty : ResearchPlan.Build(stateFor.Database, targets, researched);

    // A new set instance on every change: the map compares them by reference to decide whether to redraw.
    void ChangeTargets(Action<HashSet<string>> change)
    {
        var t = new HashSet<string>(targets, StringComparer.OrdinalIgnoreCase);
        change(t);
        targets = t;
        RecomputeRoute();
        if (stateFor is null) return;
        try
        {
            Tree.Research.Save(stateFor.Label, new ResearchState([], [.. targets]));
            researchMessage = null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            researchMessage = $"Could not save research progress: {ex.Message}";
        }
    }

    void ToggleTarget(string key) => ChangeTargets(t => { if (!t.Remove(key)) t.Add(key); });
    void RemoveTarget(string key) => ChangeTargets(t => t.Remove(key));
    void ClearRoute() => ChangeTargets(t => t.Clear());

    TechFilter Filter => new(
        search,
        tab,
        int.TryParse(tierText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var t) ? t : null,
        category.Length == 0 ? null : category,
        source.Length == 0 ? null : source,
        rare, dangerous, repeatable, starting, changed);

    protected override async Task OnInitializedAsync()
    {
        Tree.Changed += OnTreeChanged;
        Feed.Changed += OnFeedChanged;
        Feed.Start();
        choices = Tree.Choices();
        if (Tree.Current is { } current)
        {
            choiceIndex = Math.Max(0, choices.ToList().FindIndex(c => c.Label == current.Label));
            selectedKey = current.Database.Techs.Values.FirstOrDefault(t => t.IsStart)?.Key;
            SyncResearchState();
        }
        else if (!Tree.IsBuilding)
        {
            await Build();
        }
    }

    void OnFeedChanged() => _ = InvokeAsync(() => { UpdateResearched(); StateHasChanged(); });

    void OnTreeChanged() => _ = InvokeAsync(() =>
    {
        if (selectedKey is null && Tree.Current is { } current)
            selectedKey = current.Database.Techs.Values.FirstOrDefault(t => t.IsStart)?.Key;
        SyncResearchState();
        WatchIcons();
        StateHasChanged();
    });

    // The last progress report comes just before IconsReady completes, so the map's final icon redraw (IconVersion -1) needs its own render.
    Task? watchedIcons;

    void WatchIcons()
    {
        var ready = Tree.IconsReady;
        if (ready.IsCompleted || ReferenceEquals(ready, watchedIcons)) return;
        watchedIcons = ready;
        _ = RenderWhenDone(ready);
    }

    async Task RenderWhenDone(Task ready)
    {
        try { await ready; }
        catch (Exception) { /* cancelled or failed: still redraw with what loaded */ }
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { /* the page went away */ }
    }

    async Task SearchChanged()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        var cts = searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(200, cts.Token);
        }
        catch (OperationCanceledException) { return; }
        search = searchInput;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Tree.Changed -= OnTreeChanged;
        Feed.Changed -= OnFeedChanged;
        searchCts?.Cancel();
        searchCts?.Dispose();
    }

    async Task Build()
    {
        (status, error) = (null, false);
        try
        {
            var selectedLabel = choices.Count > 0 ? choices[Math.Clamp(choiceIndex, 0, choices.Count - 1)].Label : TechTreeService.CurrentGameLabel;
            choices = Tree.Choices();
            choiceIndex = Math.Max(0, choices.ToList().FindIndex(c => c.Label == selectedLabel));
            await Tree.BuildAsync(choices[choiceIndex]);
            SyncResearchState();
            var db = Tree.Current!.Database;
            status = $"{db.Techs.Count} technologies from {Tree.Current.Sources.Count} sources.";
            if (selectedKey is null || !db.Techs.ContainsKey(selectedKey))
                selectedKey = db.Techs.Values.FirstOrDefault(t => t.IsStart)?.Key ?? db.Techs.Keys.FirstOrDefault();
            if (tierText.Length > 0 && !db.Tiers.Any(t => t.ToString(CultureInfo.InvariantCulture) == tierText)) tierText = "";
            if (category.Length > 0 && !db.Categories.Contains(category, StringComparer.OrdinalIgnoreCase)) category = "";
            if (source.Length > 0 && !db.SourceNames.Contains(source)) source = "";
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or UnauthorizedAccessException
                                   or InvalidDataException or OperationCanceledException or ObjectDisposedException or ArgumentException)
        {
            (status, error) = (ex.Message, true);
            if (Tree.Current is { } cur)
            {
                var idx = choices.ToList().FindIndex(c => c.Label == cur.Label);
                if (idx >= 0) choiceIndex = idx;
            }
        }
    }

    static string TierText(Tech t) => t.IsRepeatable ? "R" : t.Tier?.ToString(CultureInfo.InvariantCulture) ?? "?";
}
