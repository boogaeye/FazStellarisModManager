@* Shows one DiffResult grouped by kind. "Who" names the compared machine: "you" or a player's name.
   Kind shows one group only ("missing", "different", "extra", "order" or "dlc"); null shows everything. *@

@if (Kind is null)
{
    @if (!Diff.IsReliable)
    {
        <p class="status warn">Some files could not be read, so some differences below may not be real. Close programs that lock mod files and rescan.</p>
        <details>
            <summary>Scan warnings (@(Diff.TargetWarnings.Count + Diff.MineWarnings.Count))</summary>
            <ul>
                @foreach (var w in Diff.TargetWarnings) { <li>Host: @w</li> }
                @foreach (var w in Diff.MineWarnings) { <li>@Who: @w</li> }
            </ul>
        </details>
    }
    @if (Diff.IsMatch)
    {
        <p class="status ok">Everything matches the host.</p>
    }
    @if (!Diff.GameVersionMatches)
    {
        <p class="status error">Game version differs: host @Diff.TargetGameVersion, @Who @Diff.MineGameVersion.</p>
    }
    @if (!Diff.BaseFiles.IsEmpty)
    {
        <p class="status error">@BaseCount base game file(s) differ. Use "Verify integrity of game files" in Steam.</p>
    }
}

@if (Kind is null or "missing")
{
    @Section($"Missing (the host has these, {Who} don't)", "k-missing", Diff.Mods.Where(m => m.Status == UnitStatus.Missing).ToList())
}
@if (Kind is null or "different")
{
    @Section("Different files", "k-different", Diff.Mods.Where(m => m.Status == UnitStatus.ContentMismatch).ToList())
}
@if (Kind is null)
{
    @* Informational: these pair fine, only through a local copy or under a different name. *@
    @Section("Matched through a local copy or different name", "k-matched", Diff.Mods.Where(m => m.Status == UnitStatus.Ok && m.Match != MatchKind.Key).ToList())
}
@if (Kind is null or "extra")
{
    @Section($"Extra ({Who} have these, the host doesn't)", "k-extra", Diff.Mods.Where(m => m.Status == UnitStatus.Extra).ToList())
}
@if (Kind is null or "order")
{
    @Section("Load order differs", "k-order", Diff.Mods.Where(m => m.OutOfOrder).ToList())
}
@if (Kind is null or "dlc")
{
    @Section("DLC differences", "k-dlc", Diff.Dlcs.Where(d => d.Status != UnitStatus.Ok).ToList())
}

@code {
    static string MatchText(MatchKind kind) => kind switch
    {
        MatchKind.WorkshopId => "Workshop id",
        MatchKind.Name => "name",
        MatchKind.Files => "identical files",
        _ => "key",
    };

    [Parameter, EditorRequired] public DiffResult Diff { get; set; } = default!;
    [Parameter] public string Who { get; set; } = "you";
    [Parameter] public string? Kind { get; set; }

    const int MaxUnits = 200;
    const int MaxFiles = 50;

    DiffResult? _renderedDiff;
    string? _renderedWho;
    string? _renderedKind;

    // Parameters usually arrive as the same references; skip the (large) re-render unless they changed.
    protected override bool ShouldRender()
    {
        if (ReferenceEquals(_renderedDiff, Diff) && ReferenceEquals(_renderedWho, Who) && _renderedKind == Kind) return false;
        _renderedDiff = Diff;
        _renderedWho = Who;
        _renderedKind = Kind;
        return true;
    }

    int BaseCount => Diff.BaseFiles.Changed.Count + Diff.BaseFiles.OnlyInTarget.Count + Diff.BaseFiles.OnlyInMine.Count;

    // cls tints the group's heading by kind. A group shown on its own (Kind set) says so when it is empty.
    RenderFragment Section(string title, string cls, List<UnitDiff> units) =>
        @<div class="diff-group @cls">
            @if (units.Count == 0 && Kind is not null)
            {
                <p class="status">@title: none.</p>
            }
            @if (units.Count > 0)
            {
                <h3>@title (@units.Count)</h3>
                <ul>
                    @foreach (var u in units.Take(MaxUnits))
                    {
                        <li>
                            <span class="name">@u.Name</span> <span class="badge">@u.Key</span>
                            @if (u.Match != MatchKind.Key && u.MineKey is { } mineKey)
                            {
                                <span class="badge">matched by @MatchText(u.Match) with @mineKey</span>
                            }
                            @if (u.LocalCopyOfWorkshop)
                            {
                                <span class="badge local" title="One side uses the Steam Workshop item, the other a local copy of it">local copy of Workshop @(ModMatcher.WorkshopIdOf(u.Key, u.RemoteId))</span>
                            }
                            @if (u.Files is { } f)
                            {
                                <details>
                                    <summary>@f.Changed.Count changed, @f.OnlyInTarget.Count only on host, @f.OnlyInMine.Count only on @Who</summary>
                                    <ul class="files">
                                        @foreach (var p in f.Changed.Take(MaxFiles)) { <li>~ @p</li> }
                                        @if (f.Changed.Count > MaxFiles) { <li>… and @(f.Changed.Count - MaxFiles) more</li> }
                                        @foreach (var p in f.OnlyInTarget.Take(MaxFiles)) { <li>- @p</li> }
                                        @if (f.OnlyInTarget.Count > MaxFiles) { <li>… and @(f.OnlyInTarget.Count - MaxFiles) more</li> }
                                        @foreach (var p in f.OnlyInMine.Take(MaxFiles)) { <li>+ @p</li> }
                                        @if (f.OnlyInMine.Count > MaxFiles) { <li>… and @(f.OnlyInMine.Count - MaxFiles) more</li> }
                                    </ul>
                                </details>
                            }
                        </li>
                    }
                    @if (units.Count > MaxUnits)
                    {
                        <li>… and @(units.Count - MaxUnits) more</li>
                    }
                </ul>
            }
        </div>;
}
