@inherits LayoutComponentBase

<div class="shell">
    <nav class="tabs">
        <span class="brand">Faz Mod Manager</span>
        <NavLink href="" Match="NavLinkMatch.All">Mods</NavLink>
        <NavLink href="session">Session</NavLink>
        <NavLink href="tech">Tech</NavLink>
        <NavLink href="settings">Settings</NavLink>
    </nav>
    <main>
        <ErrorBoundary @ref="boundary">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <p class="status error">Something went wrong in this page.</p>
                <button @onclick="() => boundary?.Recover()">Recover</button>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    ErrorBoundary? boundary;
}
